# GN arguments shared by every Brumel build profile. Not buildable on its own.
# Profiles inherit files with "# brumel-inherit: <name>" lines; later values win.
# scripts/build.py composes the final args.gn and rejects settings that would
# add Google API keys or turn off security hardening (see docs/development/BUILDING.md).

# Brumel builds use no Google API keys (docs/privacy/PRIVACY.md).
use_official_google_api_keys = false

# Product name, company and copyright for version resources and installers.
# The file lives in src/branding/ and reaches the checkout as //brumel through
# scripts/overlay.py sync, which must run before gen (ADR-0015).
branding_file_path = "//brumel/branding/BRANDING"

# Do not apply Chrome's built-in field-trial testing configuration.
disable_fieldtrial_testing_config = true

# Codecs (proprietary_codecs, ffmpeg_branding) and Widevine are decided per
# docs/architecture/COMPATIBILITY.md and docs/legal/LICENSING.md; they are not
# set here until that decision is recorded.
