{
  "schema_version": 1,
  "status": "Research / provisional",
  "note": "Source of the Brumel UI tokens. Render tokens.css and CONTRAST.md with: python3 scripts/design/render_tokens.py. Brand primitives come from DESIGN_SYSTEM.md § 3; semantic roles are what surfaces use. WebUI reads the CSS custom properties; Views maps the same roles to Brumel colour IDs in ui/color mixers.",
  "primitives": {
    "graphite": "#11151C",
    "mist": "#9AB9E8",
    "slate": "#56677F",
    "cloud": "#F4F6FA",
    "white": "#FFFFFF",
    "slate-200": "#7F93AE",
    "slate-300": "#8C9BB0",
    "mist-700": "#3B5F95",
    "oled-black": "#000000"
  },
  "roles": {
    "frame": "Window frame and tab strip background",
    "toolbar": "Toolbar, active tab and omnibox field background",
    "surface": "Page background of internal pages",
    "raised": "Bubbles, menus, cards and dialogs",
    "hover": "Hover fill on tabs, rows and toolbar buttons",
    "selected": "Selected row or current navigation item",
    "ink": "Primary text and icons",
    "ink-muted": "Secondary text and inactive icons",
    "accent": "Links, current state and the primary action as text or icon",
    "accent-fill": "Primary button and on-state of switches",
    "on-accent": "Text and icons on accent-fill",
    "focus": "Keyboard focus ring",
    "control-border": "Borders that identify a control (inputs, switches, checkboxes)",
    "divider": "Decorative separators; never the only cue for a boundary",
    "danger": "Destructive actions and errors",
    "warning": "Warnings",
    "success": "Confirmations"
  },
  "themes": {
    "light": {
      "frame": "#E6EAF1",
      "toolbar": "{white}",
      "surface": "{cloud}",
      "raised": "{white}",
      "hover": "#E9EDF4",
      "selected": "#E3EAF6",
      "ink": "{graphite}",
      "ink-muted": "{slate}",
      "accent": "{mist-700}",
      "accent-fill": "{mist-700}",
      "on-accent": "{white}",
      "focus": "{mist-700}",
      "control-border": "#71829A",
      "divider": "#DCE2EB",
      "danger": "#B42318",
      "warning": "#8A5300",
      "success": "#1E6B43"
    },
    "dark": {
      "frame": "#0B0E13",
      "toolbar": "#1A202A",
      "surface": "{graphite}",
      "raised": "#1A202A",
      "hover": "#232A36",
      "selected": "#233149",
      "ink": "{cloud}",
      "ink-muted": "{slate-300}",
      "accent": "{mist}",
      "accent-fill": "{mist}",
      "on-accent": "{graphite}",
      "focus": "{mist}",
      "control-border": "#6B7D95",
      "divider": "#262E3A",
      "danger": "#F4A097",
      "warning": "#E9C46A",
      "success": "#7CCB9E"
    },
    "oled": {
      "frame": "{oled-black}",
      "toolbar": "#0B0D11",
      "surface": "{oled-black}",
      "raised": "#0B0D11",
      "hover": "#171B22",
      "selected": "#1A2638",
      "ink": "{cloud}",
      "ink-muted": "{slate-300}",
      "accent": "{mist}",
      "accent-fill": "{mist}",
      "on-accent": "{graphite}",
      "focus": "{mist}",
      "control-border": "#6B7D95",
      "divider": "#1C222C",
      "danger": "#F4A097",
      "warning": "#E9C46A",
      "success": "#7CCB9E"
    }
  },
  "checks": [
    {"fg": "ink", "bg": ["frame", "toolbar", "surface", "raised", "hover", "selected"], "min": 4.5},
    {"fg": "ink-muted", "bg": ["frame", "toolbar", "surface", "raised", "hover", "selected"], "min": 4.5},
    {"fg": "accent", "bg": ["toolbar", "surface", "raised", "selected"], "min": 4.5},
    {"fg": "on-accent", "bg": ["accent-fill"], "min": 4.5},
    {"fg": "focus", "bg": ["frame", "toolbar", "surface", "raised", "hover"], "min": 3.0},
    {"fg": "control-border", "bg": ["toolbar", "surface", "raised"], "min": 3.0},
    {"fg": "danger", "bg": ["surface", "raised"], "min": 4.5},
    {"fg": "warning", "bg": ["surface", "raised"], "min": 4.5},
    {"fg": "success", "bg": ["surface", "raised"], "min": 4.5}
  ],
  "scale": {
    "font": {
      "ui": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, \"Cantarell\", \"Noto Sans\", sans-serif",
      "mono": "ui-monospace, \"Cascadia Mono\", \"Consolas\", \"DejaVu Sans Mono\", monospace"
    },
    "text": {"xs": "12px", "sm": "13px", "md": "14px", "lg": "16px", "xl": "20px", "2xl": "24px", "3xl": "32px"},
    "leading": {"ui": "1.4", "prose": "1.6"},
    "weight": {"regular": "400", "medium": "500", "strong": "600"},
    "space": {"1": "2px", "2": "4px", "3": "8px", "4": "12px", "5": "16px", "6": "24px", "7": "32px", "8": "48px", "9": "64px"},
    "radius": {"sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px"},
    "control": {"height": "32px", "height-lg": "40px", "hit": "44px"},
    "motion": {
      "quick": "120ms",
      "standard": "200ms",
      "gentle": "320ms",
      "ease": "cubic-bezier(0.2, 0, 0, 1)",
      "ease-gentle": "cubic-bezier(0.3, 0, 0, 1)"
    }
  }
}
