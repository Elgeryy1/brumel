{
  "schema_version": 1,
  "status": "Research / provisional",
  "note": "Source of the Brumel UI tokens. Render tokens.css and CONTRAST.md with: python3 scripts/design/render_tokens.py. Brand primitives come from DESIGN_SYSTEM.md § 3; semantic roles are what surfaces use. WebUI reads the CSS custom properties; Views maps the same roles to Brumel colour IDs in ui/color mixers.",
  "primitives": {
    "graphite": "#11151C",
    "mist": "#9AB9E8",
    "slate": "#56677F",
    "cloud": "#F4F6FA",
    "white": "#FFFFFF",
    "slate-200": "#7F93AE",
    "slate-300": "#8C9BB0",
    "mist-700": "#3B5F95",
    "oled-black": "#000000"
  },
  "roles": {
    "frame": "Window frame and tab strip background",
    "toolbar": "Toolbar, active tab and omnibox field background",
    "surface": "Page background of internal pages",
    "raised": "Bubbles, menus, cards and dialogs",
    "hover": "Hover fill on tabs, rows and toolbar buttons",
    "selected": "Selected row or current navigation item",
    "ink": "Primary text and icons",
    "ink-muted": "Secondary text and inactive icons",
    "accent": "Links, current state and the primary action as text or icon",
    "accent-fill": "Primary button and on-state of switches",
    "accent-fill-hover": "Hover fill of the primary button",
    "on-accent": "Text and icons on accent-fill",
    "focus": "Keyboard focus ring",
    "control-border": "Borders that identify a control (inputs, switches, checkboxes)",
    "divider": "Decorative separators; never the only cue for a boundary",
    "danger": "Destructive actions and errors",
    "warning": "Warnings",
    "success": "Confirmations",
    "brand-field": "Surfaces that carry the brand: the New Tab page, first run and About identity blocks",
    "band-1": "First mist band of the Haze mark, used as the active-tab marker and the brand rule; never text",
    "band-2": "Second mist band of the Haze mark; never text"
  },
  "themes": {
    "light": {
      "frame": "#E0E8F5",
      "toolbar": "{white}",
      "surface": "{cloud}",
      "raised": "{white}",
      "hover": "#DBE4F3",
