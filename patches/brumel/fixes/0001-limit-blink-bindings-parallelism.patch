Description: Keep Blink bindings generation within the memory of a local
 build machine. Upstream splits it into about ten generate_bindings_* actions
 that run in parallel (designed for remote execution), and each starts one
 worker process per CPU thread. On a 24-thread machine with 32 GB of RAM this
 exhausted memory and hung the machine three times in the build spike. The
 actions now share a GN pool of depth 1, and each uses at most 8 workers
 (BLINK_BINDINGS_JOBS overrides it). Build-only; the generated code is
 unchanged.
Origin: brumel
Module: fixes
Feature: CORE-001
Upstreamable: maybe
SPDX-License-Identifier: BSD-3-Clause

diff --git a/third_party/blink/renderer/bindings/BUILD.gn b/third_party/blink/renderer/bindings/BUILD.gn
--- a/third_party/blink/renderer/bindings/BUILD.gn
+++ b/third_party/blink/renderer/bindings/BUILD.gn
@@ -17,6 +17,13 @@
 visibility = [ "//third_party/blink/renderer/*" ]
 
 bindings_gen_dir = get_path_info(".", "gen_dir")
+
+# Runs the per-type bindings generators one at a time. Each starts its own
+# pool of worker processes, so running them all at once on a local build
+# multiplies memory use by the number of actions.
+pool("generate_bindings_pool") {
+  depth = 1
+}
 
 template("collect_idl_files") {
   action_with_pydeps(target_name) {
@@ -143,6 +150,8 @@
 
     if (defined(invoker.pool)) {
       pool = invoker.pool
+    } else {
+      pool = ":generate_bindings_pool"
     }
 
     web_idl_database_outputs = get_target_outputs(":web_idl_database")
diff --git a/third_party/blink/renderer/bindings/scripts/bind_gen/task_queue.py b/third_party/blink/renderer/bindings/scripts/bind_gen/task_queue.py
--- a/third_party/blink/renderer/bindings/scripts/bind_gen/task_queue.py
+++ b/third_party/blink/renderer/bindings/scripts/bind_gen/task_queue.py
@@ -5,6 +5,7 @@
 import dataclasses
 import functools
 import multiprocessing
+import os
 import sys
 import typing
 
@@ -39,6 +40,12 @@
         else:
             self._single_process = False
             self._pool_size = multiprocessing.cpu_count()
+            # Several generate_bindings_* actions can run at the same time.
+            # One worker per CPU thread in each of them exhausts the memory
+            # of a local build machine, so cap the workers per action.
+            self._pool_size = min(
+                self._pool_size,
+                max(1, int(os.environ.get('BLINK_BINDINGS_JOBS', '8'))))
             if sys.platform == 'win32':
                 # TODO(crbug.com/1190269) - we can't use more than 56
                 # cores on Windows or Python3 may hang.
