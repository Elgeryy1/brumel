# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,gn,gni}]
indent_size = 4

[*.{cc,cpp,h,hpp,mm}]
# Chromium C++ style (clang-format, Chromium profile).
indent_size = 2
max_line_length = 80

[*.rs]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a Markdown hard line break; we avoid them, but do not strip silently.
trim_trailing_whitespace = false

[*.patch]
# Patches must stay byte-exact: never re-indent or strip whitespace inside them.
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
